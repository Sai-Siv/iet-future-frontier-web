# Copy to backend/.env and fill in. Never commit the real file.
PORT=5000
NODE_ENV=development

# Firebase Admin SDK: Firebase Console > Project settings > Service accounts > Generate new private key.
# Copy project_id, client_email and private_key from the downloaded JSON, then delete that file.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudinary (file storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (confirmation emails). Emails are skipped if the key is empty.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_SENDER_NAME=

# Optional
# ALLOWED_ORIGINS=https://preview.example.com,https://other.example.com
# TRUST_PROXY_HOPS=1
# RATE_LIMIT_API_MAX=300
# RATE_LIMIT_REGISTRATION_MAX=60
