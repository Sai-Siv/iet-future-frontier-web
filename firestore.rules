rules_version = '2';

// All reads and writes go through the backend, which uses the Firebase Admin SDK.
// The Admin SDK is not subject to these rules, so nothing else needs direct access.
// Publish only AFTER the Admin SDK backend is deployed, or registrations will fail.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
