rules_version = '2';

// The website saves registrations through the backend (Firebase Admin SDK), which these
// rules do not apply to. The only direct access is read-only, for the admin dashboard,
// and only for username and password accounts marked as admins by backend/scripts/adminUser.js.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.admin == true;
    }

    match /{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
